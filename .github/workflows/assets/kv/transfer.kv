<TransferScreen>
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "File Transfer"
            elevation: 4
            left_action_items: [['arrow-left', lambda x: app.go_home()]]
        
        MDBoxLayout:
            orientation: 'vertical'
            padding: dp(16)
            spacing: dp(16)
            
            MDCard:
                orientation: 'vertical'
                padding: dp(16)
                size_hint_y: None
                height: dp(120)
                elevation: 4
                
                MDLabel:
                    id: transfer_file_name
                    text: "Transferring: file.txt"
                    font_style: 'H6'
                
                MDLabel:
                    id: transfer_status
                    text: "0 of 0 KB"
                    theme_text_color: 'Secondary'
                
                MDProgressBar:
                    id: transfer_progress
                    value: 0
                    max: 100
            
            MDCard:
                orientation: 'vertical'
                padding: dp(16)
                size_hint_y: None
                height: dp(100)
                elevation: 4
                
                MDLabel:
                    text: "Speed"
                    font_style: 'H6'
                
                MDLabel:
                    id: speed_label
                    text: "0 KB/s"
                    theme_text_color: 'Secondary'
            
            Widget:
            
            MDBoxLayout:
                orientation: 'horizontal'
                spacing: dp(16)
                size_hint_y: None
                height: dp(48)
                pos_hint: {'center_x': 0.5}
                size_hint_x: None
                width: dp(300)
                
                MDRaisedButton:
                    text: "Cancel"
                    size_hint_x: None
                    width: dp(140)
                    md_bg_color: 1, 0.3, 0.3, 1
                    on_release: app.cancel_transfer()
                
                MDRaisedButton:
                    text: "Pause"
                    size_hint_x: None
                    width: dp(140)
                    on_release: app.pause_transfer()

<TransferHistoryItem>
    MDCard:
        orientation: 'horizontal'
        padding: dp(8)
        spacing: dp(8)
        size_hint_y: None
        height: dp(60)
        
        MDIcon:
            icon: 'upload' if root.transfer_type == 'upload' else 'download'
            size_hint_x: None
            width: dp(36)
            theme_text_color: 'Custom'
            text_color: 0, 0.7, 0, 1 if root.status == 'completed' else 0.7, 0, 0, 1
        
        MDBoxLayout:
            orientation: 'vertical'
            
            MDLabel:
                text: root.file_name
                font_style: 'Subtitle1'
                size_hint_y: None
                height: dp(24)
            
            MDLabel:
                text: f"{root.file_size} - {root.status}"
                theme_text_color: 'Secondary'
                font_size: dp(12)
                size_hint_y: None
                height: dp(18)
        
        MDLabel:
            text: root.time
            theme_text_color: 'Secondary'
            font_size: dp(10)
            size_hint_x: None
            width: dp(80)