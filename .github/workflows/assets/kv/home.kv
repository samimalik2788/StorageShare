<HomeScreen>
    MDBoxLayout:
        orientation: 'vertical'
        
        MDTopAppBar:
            title: "StorageShare"
            elevation: 4
            left_action_items: [['menu', lambda x: None]]
            right_action_items: [['refresh', lambda x: app.refresh_devices()], ['wifi', lambda x: app.toggle_internet_mode()]]
        
        MDBoxLayout:
            orientation: 'vertical'
            padding: dp(8)
            
            MDLabel:
                text: "Paired Devices"
                font_style: 'H5'
                size_hint_y: None
                height: dp(40)
            
            RecycleView:
                id: devices_list
                viewclass: 'DeviceCard'
                RecycleBoxLayout:
                    default_size: None, dp(80)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'
                    spacing: dp(8)
                    padding: dp(4)
            
            MDFlatButton:
                text: "Discover Nearby Devices"
                pos_hint: {'center_x': 0.5}
                size_hint: None, None
                size: dp(250), dp(48)
                on_release: app.go_to_discovery()
                md_bg_color: app.theme_cls.accent_color
                text_color: 1, 1, 1, 1
        
        MDBottomNavigation:
            panel_color: app.theme_cls.primary_color
            
            MDBottomNavigationItem:
                name: 'home'
                text: 'Home'
                icon: 'home'
                on_tab_press: app.switch_to('home')
            
            MDBottomNavigationItem:
                name: 'discover'
                text: 'Discover'
                icon: 'wifi'
                on_tab_press: app.switch_to('discover')
            
            MDBottomNavigationItem:
                name: 'settings'
                text: 'Settings'
                icon: 'cog'
                on_tab_press: app.switch_to('settings')

<DeviceCard>
    MDCard:
        orientation: 'horizontal'
        padding: dp(8)
        spacing: dp(8)
        size_hint_y: None
        height: dp(80)
        ripple_behavior: True
        on_release: app.open_device_storage(root.device_id)
        
        MDIcon:
            icon: 'cellphone'
            size_hint_x: None
            width: dp(40)
            theme_text_color: 'Custom'
            text_color: app.theme_cls.primary_color
        
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(2)
            
            MDLabel:
                text: root.device_name
                font_style: 'H6'
                size_hint_y: None
                height: dp(24)
            
            MDLabel:
                text: f"{root.used_mb}MB / {root.quota_mb}MB used"
                theme_text_color: 'Secondary'
                size_hint_y: None
                height: dp(20)
            
            MDProgressBar:
                value: root.usage_percent
                max: 100
                size_hint_y: None
                height: dp(6)
        
        MDLabel:
            text: "●"
            font_size: dp(16)
            size_hint_x: None
            width: dp(20)
            theme_text_color: 'Custom'
            text_color: 0, 1, 0, 1 if root.is_connected else 1, 0, 0, 1